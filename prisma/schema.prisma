// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  VEGETABLES
  FRUITS
  HERBS
  DAIRY
  MEAT
  GRAINS
  BAKERY
  OTHER
}

enum MarketDayStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum MarketScheduleStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  PENDING_REVIEW
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  BANNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderItemStatus {
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password      String
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?

  orders        Order[]
  account       Account[]
  session       Session[]
  vendorProfile VendorProfile?
  carts         Cart[] //
  favorites     Favorite[]
}

model VendorProfile {
  id              Int      @id @default(autoincrement())
  businessName    String
  description     String   @db.Text
  specialty       String
  phone           String?
  email           String
  headerImageUrl  String
  address         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  facebookHandle  String?
  instagramHandle String?
  websiteUrl      String?
  youtubeHandle   String?
  twitterHandle   String?
  status          VendorStatus @default(PENDING)

  userId Int @unique

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]
  marketDays      MarketDay[]
  marketSchedules MarketSchedule[]
}

model Product {
  id          Int             @id @default(autoincrement())
  name        String
  description String          @db.Text
  category    ProductCategory
  imageUrl    String
  organic     Boolean         @default(false)
  local       Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vendorProfileId Int

  vendorProfile     VendorProfile      @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  favorites         Favorite[]
  variations        ProductVariation[]
  marketDayProducts MarketDayProduct[]
}

model ProductVariation {
  id       Int         @id @default(autoincrement())
  name     String
  price    Float
  size     Int
  packaged Boolean

  productId     Int
  productUnitId Int

  product             Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit     ProductUnit @relation(fields: [productUnitId], references: [id])
  marketDayVariations MarketDayProductVariation[]
}

model Order {
  id        Int         @id @default(autoincrement())
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userId      Int
  marketDayId Int

  user       User        @relation(fields: [userId], references: [id])
  marketDay  MarketDay   @relation(fields: [marketDayId], references: [id])
  orderItems OrderItem[]
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  quantity  Int
  price     Float           // Price at time of purchase
  packaged  Boolean         // Packaged at time of purchase
  size      Int             // Size at time of purchase
  status    OrderItemStatus @default(PROCESSING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  orderId                     Int
  productUnitId               Int // Unit at time of purchase
  marketDayProductVariationId Int

  order                     Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  unit                      ProductUnit               @relation(fields: [productUnitId], references: [id])
  marketDayProductVariation MarketDayProductVariation @relation(fields: [marketDayProductVariationId], references: [id])
}

model MarketDay {
  id              Int            @id @default(autoincrement())
  description     String?        @db.Text
  startTime       DateTime
  endTime         DateTime
  onlineStartTime DateTime
  onlineEndTime   DateTime
  status          MarketDayStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  marketScheduleId Int

  marketSchedule    MarketSchedule     @relation(fields: [marketScheduleId], references: [id], onDelete: Cascade)
  vendors           VendorProfile[]
  orders            Order[]
  carts             Cart[]
  marketDayProducts MarketDayProduct[]
}

// TODO: Figure out how to think about interval scheduling
model MarketSchedule {
  id              Int                 @id @default(autoincrement())
  reoccurring     Boolean
  name            String
  location        String
  description     String              @db.Text
  startTime       DateTime
  endTime         DateTime
  onlineStartTime DateTime
  onlineEndTime   DateTime
  status          MarketScheduleStatus @default(DRAFT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  subscriptions VendorProfile[]
  marketDay     MarketDay[]
}

model Account {
  id                Int     @id @default(autoincrement())
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  expires      DateTime

  userId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProductUnit {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g., "lb", "ea", "bag", "dozen"
  pluralName  String // e.g., "lbs", "units", "s", "dozen"
  displayName String // e.g., "Pound", "Each", "Bag", "Dozen"
  symbol      String   @unique // e.g., "$/lb", "$/ea", "$/bag"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems       OrderItem[]
  ProductVariation ProductVariation[]
}

model MarketDayProduct {
  id        Int      @id @default(autoincrement())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketDayId Int
  productId   Int

  marketDay  MarketDay                   @relation(fields: [marketDayId], references: [id], onDelete: Cascade)
  product    Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variations MarketDayProductVariation[]
}

model MarketDayProductVariation {
  id        Int      @id @default(autoincrement())
  price     Float
  quantity  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketDayProductId Int
  productVariationId Int

  marketDayProduct MarketDayProduct @relation(fields: [marketDayProductId], references: [id], onDelete: Cascade)
  productVariation ProductVariation @relation(fields: [productVariationId], references: [id], onDelete: Cascade)
  CartItem         CartItem[]
  OrderItem        OrderItem[]

  @@unique([marketDayProductId, productVariationId])
}

model Cart {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId      Int
  marketDayId Int

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketDay MarketDay  @relation(fields: [marketDayId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([userId, marketDayId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartId                      Int
  marketDayProductVariationId Int

  cart                      Cart                      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  marketDayProductVariation MarketDayProductVariation @relation(fields: [marketDayProductVariationId], references: [id])

  @@unique([cartId, marketDayProductVariationId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}
