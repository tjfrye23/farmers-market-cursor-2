{
  "name": "farmers-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "format": "prettier --write .",
    "clean": "rm -rf .next out coverage .turbo .vercel build dist",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down -v",
    "db:visualize": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:empty": "npx prisma migrate dev --skip-seed",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:schema:format": "npx prisma format",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@tailwindcss/postcss": "^4.1.4",
    "@tanstack/react-query": "^5.79.0",
    "@tanstack/react-query-devtools": "^5.79.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.358.0",
    "mysql2": "^3.14.1",
    "next": "15.3.1",
    "next-auth": "^4.24.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^4.5.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.2.8",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.0",
    "@commitlint/cli": "^19.2.0",
    "@commitlint/config-conventional": "^19.1.0",
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^9.0.1",
    "@storybook/addon-docs": "^9.0.1",
    "@storybook/addon-onboarding": "^9.0.1",
    "@storybook/addon-vitest": "^9.0.1",
    "@storybook/nextjs-vite": "^9.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitest/browser": "^3.1.4",
    "@vitest/coverage-v8": "^3.1.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "15.3.1",
    "eslint-plugin-storybook": "^9.0.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "lint-staged": "^15.2.2",
    "playwright": "^1.52.0",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "prisma": "^6.8.2",
    "storybook": "^9.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3.1.4"
  },
  "overrides": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
